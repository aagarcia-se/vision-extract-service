generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

enum ExtractionStatus {
  PENDING
  COMPLETED
  FAILED
}

model Extraction {
  id           String           @id @default(cuid())
  clientId     String
  templateUsed String
  status       ExtractionStatus @default(PENDING)
  rawResult    Json?
  mappedResult Json?
  errorMessage String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([clientId])
  @@index([status])
  @@map("extractions")
}
