# Servidor
NODE_ENV=development
PORT=3000

# Google Cloud Vision (ajustar segun el proveedor cloud que definamos)
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-vision-key.json

# Base de datos — Turso
# DATABASE_URL: solo la usa el CLI de Prisma LOCALMENTE para generar el SQL de las migraciones
# (no es la conexion real que usa la app en runtime)
DATABASE_URL="file:./prisma/dev.db"

# Credenciales reales de Turso, usadas en runtime por el driver adapter
TURSO_DATABASE_URL="libsql://vision-extract-service-aagarcia-se.aws-us-east-1.turso.io"
TURSO_AUTH_TOKEN="libsql://vision-extract-service-aagarcia-se.aws-us-east-1.turso.io"
