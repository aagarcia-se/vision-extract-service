# Servidor
NODE_ENV=development
PORT=3000

# Base de datos — Turso (conexion directa, sin ORM)
TURSO_DATABASE_URL=libsql://tu-database.turso.io
TURSO_AUTH_TOKEN=tu-token-de-turso

# Proveedores de vision generativa
GEMINI_API_KEY=tu-api-key-de-gemini
ANTHROPIC_API_KEY=tu-api-key-de-anthropic

# Autenticacion servicio-a-servicio (header x-api-key)
SERVICE_API_KEY=una-clave-larga-y-aleatoria
